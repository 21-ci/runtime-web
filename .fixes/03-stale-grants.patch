+func TestCreateProjectPurgesStaleGrants(t *testing.T) {
+	f := newFixture(t)
+	ctx := context.Background()
+	// A grant left behind for a slug whose project no longer exists.
+	if err := f.st.Q().UpsertGrant(ctx, db.UpsertGrantParams{OrgID: f.org.ID, UserID: f.uid, ProjectSlug: "reused", Role: authz.RoleViewer}); err != nil {
+		t.Fatalf("UpsertGrant: %v", err)
+	}
+	if _, err := f.svc.CreateProject(ctx, owner, f.org.ID, "reused", "", nil); err != nil {
+		t.Fatalf("CreateProject: %v", err)
+	}
+	gs, err := f.st.Q().ListGrantsForUser(ctx, db.ListGrantsForUserParams{OrgID: f.org.ID, UserID: f.uid})
+	if err != nil || len(gs) != 0 {
+		t.Fatalf("grants = %+v, %v; want none (stale grant must not re-activate)", gs, err)
+	}
+}
