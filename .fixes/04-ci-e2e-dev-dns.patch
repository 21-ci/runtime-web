diff --git a/internal/api/routes_dev.go b/internal/api/routes_dev.go
new file mode 100644
index 0000000..df4c0bb
--- /dev/null
+++ b/internal/api/routes_dev.go
@@ -0,0 +1,36 @@
+package api
+
+import (
+	"fmt"
+	"net/http"
+
+	"github.com/21cloud/runtime-web/internal/apperr"
+	"github.com/21cloud/runtime-web/internal/authz"
+)
+
+// registerDevRoutes adds dev-only routes; they exist only when Deps.DevDNS is set (RTWEB_DEV=1).
+func (s *Server) registerDevRoutes() {
+	if s.deps.DevDNS == nil {
+		return
+	}
+	s.route(http.MethodPut, "/api/admin/dev/dns-override", authz.InstanceAdmin, s.putDevDNSOverride)
+}
+
+type devDNSReq struct {
+	Name   string   `json:"name"`
+	Values []string `json:"values"`
+}
+
+// putDevDNSOverride sets (or, with no values, clears) a TXT override in the dev resolver.
+func (s *Server) putDevDNSOverride(w http.ResponseWriter, r *http.Request) error {
+	var in devDNSReq
+	if err := decodeJSON(w, r, &in); err != nil {
+		return err
+	}
+	if in.Name == "" {
+		return fmt.Errorf("api: dev dns override: name required: %w", apperr.ErrInvalid)
+	}
+	s.deps.DevDNS.Set(in.Name, in.Values)
+	w.WriteHeader(http.StatusNoContent)
+	return nil
+}
diff --git a/internal/api/routes_dev_test.go b/internal/api/routes_dev_test.go
new file mode 100644
index 0000000..1346436
--- /dev/null
+++ b/internal/api/routes_dev_test.go
@@ -0,0 +1,41 @@
+package api
+
+import (
+	"context"
+	"net/http"
+	"testing"
+
+	"github.com/21cloud/runtime-web/internal/domains"
+)
+
+func TestDevDNSOverrideRoute(t *testing.T) {
+	dev := domains.NewDevResolver(nil)
+	e := newTestEnvWith(t, func(d *Deps) { d.DevDNS = dev })
+	e.mkAdmin("admin@example.com")
+	cookie, csrf := e.session("admin@example.com")
+
+	body := map[string]any{"name": "_rtweb.Docs.Custom.Test.", "values": []string{"tok"}}
+	rec := e.send(http.MethodPut, "/api/admin/dev/dns-override", body, withCookie(cookie), withCSRF(csrf))
+	expectStatus(t, rec, http.StatusNoContent)
+	got, err := dev.LookupTXT(context.Background(), "_rtweb.docs.custom.test")
+	if err != nil || len(got) != 1 || got[0] != "tok" {
+		t.Fatalf("LookupTXT = %v, %v", got, err)
+	}
+
+	// Non-admins are refused.
+	e.mkUser("user@example.com", "user-passphrase-123")
+	uc, ucsrf := e.login("user@example.com", "user-passphrase-123")
+	rec = e.send(http.MethodPut, "/api/admin/dev/dns-override", body, withCookie(uc), withCSRF(ucsrf))
+	if rec.Code != http.StatusForbidden && rec.Code != http.StatusNotFound {
+		t.Fatalf("non-admin status = %d, want 403/404", rec.Code)
+	}
+}
+
+func TestDevDNSOverrideRouteAbsentOutsideDev(t *testing.T) {
+	e := newTestEnv(t)
+	e.mkAdmin("admin@example.com")
+	cookie, csrf := e.session("admin@example.com")
+	rec := e.send(http.MethodPut, "/api/admin/dev/dns-override",
+		map[string]any{"name": "_rtweb.x.test", "values": []string{"t"}}, withCookie(cookie), withCSRF(csrf))
+	expectStatus(t, rec, http.StatusNotFound)
+}
