# Runtime Web configuration.
# Quick start: cp .env.example .env && docker compose up -d --build --wait
# Every value marked dev-insecure-* is a placeholder for local development only.
# Compose reads this file for interpolation; rtweb also receives it via env_file.

# 1. Runtime node (runtime-copy; built from RUNTIME_SRC by docker-compose.yml)
# Path to the runtime-copy checkout (read-only input). Default: ../runtime-copy.
# RUNTIME_SRC=../runtime-copy
# Control API as seen from rtweb on the compose network (port 8081 is the control listener).
RUNTIME_URL=http://runtime:8081
# Public base of the runtime as seen from the browser; app URLs are RUNTIME_PUBLIC_URL/s/{slug}/.
# Published on loopback by compose at RUNTIME_PUBLIC_PORT.
RUNTIME_PUBLIC_URL=http://localhost:8082
RUNTIME_PUBLIC_PORT=8082
# Root token of the runtime (RT_ROOT_TOKEN in the runtime). rtweb uses it for the control API.
RUNTIME_ROOT_TOKEN=dev-insecure-runtime-root
# 64 hex chars (RT_MASTER_KEY in the runtime, encrypts runtime secrets at rest). This value is a
# public dev key: generate a real one with `openssl rand -hex 32` for anything beyond local use.
RUNTIME_MASTER_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
# Plan assigned to new tenants. deploy/runtime/rt.toml defines [plans.standard].
RUNTIME_DEFAULT_PLAN=standard

# 2. Console (rtweb)
# Public URL of the console as seen from the browser. Must be a different site from
# RUNTIME_PUBLIC_URL and BASE_DOMAIN (in dev a local console host skips this check).
RTWEB_PUBLIC_URL=http://console.localhost:8080
# Listen address inside the container (compose sets this; used for non-compose runs).
RTWEB_LISTEN=:8090
# SQLite path. Compose stores it on the rtweb-data volume; outside compose use a local path.
RTWEB_DB=./data/rtweb.db
# 1 = dev mode: accepts dev-insecure-* secrets, the local console host and RTWEB_DEV_DNS_OVERRIDE.
RTWEB_DEV=1
# First-run setup token. If unset, rtweb generates a one-time token and logs it at WARN on start
# (intended); it is useless once setup completes. Set it explicitly if logs are shipped to a
# shared aggregator before setup.
RTWEB_SETUP_TOKEN=dev-insecure-setup
# Comma-separated CIDRs of reverse proxies (rtrouter, 172.28.0.10 on the compose network) whose
# X-Forwarded-For is trusted for the client IP. Empty (default) trusts none.
RTWEB_TRUSTED_PROXIES=172.28.0.10/32
# 64 hex chars in production; dev-insecure-* is accepted only with RTWEB_DEV=1.
RTWEB_SECRET_KEY=dev-insecure-secret-key
# Dev only (RTWEB_DEV=1): TXT answers for custom-domain verification, `name=value;name=value`.
# Leave empty to use the system resolver.
RTWEB_DEV_DNS_OVERRIDE=
# Log level: debug, info, warn, error.
LOG_LEVEL=info

# 3. Router and domains (rtrouter)
# Shared secret between rtrouter and rtweb for GET /api/internal/router/routes.
ROUTER_SHARED_SECRET=dev-insecure-router
# Host port on 127.0.0.1 for the router (console, base-domain apps and custom domains).
ROUTER_HTTP_PORT=8080
# TLS mode. off = plain HTTP on the router port (dev, e2e). on = :443 TLS with ACME (production).
ROUTER_TLS=off
# Base domain for app hosts: {slug}.BASE_DOMAIN. Must not be the console's or runtime's site.
BASE_DOMAIN=apps.localhost
# Base URL of rtweb as seen by rtrouter (compose network). Set by docker-compose.yml.
# ROUTER_RTWEB_URL=http://rtweb:8090
# Console host name served by the router; defaults to the host of RTWEB_PUBLIC_URL.
# ROUTER_CONSOLE_HOST=console.localhost
# ACME (ROUTER_TLS=on only)
ACME_EMAIL=ops@example.net
# ACME directory. Empty = Let's Encrypt production. CI points it at Pebble (deploy/compose.pebble.yml).
ROUTER_ACME_CA=
# Certificate storage inside the router container (volume router-data).
# ROUTER_CERT_DIR=/data/certs
# Optional wildcard certificate for BASE_DOMAIN (PEM paths inside the router container).
ROUTER_WILDCARD_CERT=
ROUTER_WILDCARD_KEY=

# Before production
# - Replace every dev-insecure-* value with a random secret (openssl rand -hex 32).
# - Set RTWEB_DEV=0 (or unset) so dev-insecure keys are refused and RTWEB_DEV_DNS_OVERRIDE is ignored.
# - Set ROUTER_TLS=on and use HTTPS URLs for RTWEB_PUBLIC_URL and RUNTIME_PUBLIC_URL.
# - RTWEB_PUBLIC_URL must be a different site from RUNTIME_PUBLIC_URL and BASE_DOMAIN.
# - Set RTWEB_TRUSTED_PROXIES only to the addresses of proxies you control.
