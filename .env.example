# Runtime Web configuration.
# Quick start: cp .env.example .env && docker compose up
# Every value marked dev-insecure-* is a placeholder for local development only.

# 1. Runtime node
RUNTIME_URL=http://runtime:8080
RUNTIME_PUBLIC_URL=https://run.example.net
RUNTIME_ROOT_TOKEN=dev-insecure-runtime-root
RUNTIME_DEFAULT_PLAN=standard

# 2. Console
RTWEB_PUBLIC_URL=http://localhost:8090
RTWEB_LISTEN=:8090
RTWEB_DB=./data/rtweb.db
RTWEB_DEV=1
RTWEB_SETUP_TOKEN=dev-insecure-setup
# 64 hex chars in production; dev-insecure-* is accepted only with RTWEB_DEV=1.
RTWEB_SECRET_KEY=dev-insecure-secret-key

# 3. Router and domains
ROUTER_SHARED_SECRET=dev-insecure-router
BASE_DOMAIN=apps.example.net
ACME_EMAIL=ops@example.net

# Before production
# - Replace every dev-insecure-* value with a random secret (openssl rand -hex 32).
# - Set RTWEB_DEV=0 (or unset) so dev-insecure keys are refused.
# - RTWEB_PUBLIC_URL must be a different site from RUNTIME_PUBLIC_URL and BASE_DOMAIN.
# - Use HTTPS URLs for RTWEB_PUBLIC_URL and RUNTIME_PUBLIC_URL.
