# Runtime Web configuration. The backend is a 21 Cloud Runtime service (server/), so there is
# no process to start here: values below are read by the install/deploy scripts, set by them as
# the service's env and secrets, or read by the e2e suite. Copy to .env and `set -a; . ./.env`
# before running make server-install / make e2e. dev-insecure-* values are placeholders only.

# 1. Install / deploy scripts (server/scripts/install.mjs, deploy.mjs)
# Root (operator) token of the runtime node. Read from the environment only, never printed.
RT_ROOT_TOKEN=dev-insecure-runtime-root
# Control API and invoke listener of the node.
RT_API=http://127.0.0.1:8081
RT_INVOKE=http://127.0.0.1:8080
# Tenant and service slug the console is installed as.
RTWEB_TENANT=runtime-web
RTWEB_SLUG=rtweb
# Plan of the console's own tenant (deploy/rt.rtweb.toml defines [plans.rtweb]; install falls
# back to "free" with a warning when the node lacks it; deploy.mjs defaults to "free").
RTWEB_PLAN=rtweb
# Console host to map on the runtime (custom host), e.g. console.example.com. Empty: none.
RTWEB_HOST=
# Version of the rtctl SDK that install publishes.
RTCTL_SDK_VERSION=0.1.0

# 2. Service env (install sets these on the rtweb service; server/src/config.ts validates them)
# Browser origin of the console, compared to Origin on unsafe methods. https unless
# RTWEB_INSECURE_COOKIES=1. Default in install: RT_INVOKE.
RTWEB_ORIGIN=http://127.0.0.1:8080
# Public base of the runtime as seen from the browser; app URLs are <this>/s/{slug}/.
# Empty keeps app URLs relative. Default in install: RT_INVOKE.
RTWEB_RUNTIME_PUBLIC_URL=http://127.0.0.1:8080
# Runtime plan given to new org tenants (default "free"). Must exist on the node: an org create
# with an unknown plan fails with 500 default_plan_missing naming this variable.
RTWEB_DEFAULT_PLAN=free
# Dev/local only: 1 drops __Host- and Secure from cookies and allows an http origin.
RTWEB_INSECURE_COOKIES=1
# Build label reported by /healthz (default "dev").
RTWEB_VERSION=dev

# 3. Service secrets (install generates them once and never rotates them; listed for reference)
# RTWEB_SEAL_KEY     32 random bytes, base64: AES-256-GCM key for secrets at rest (default keys, TOTP).
# RTWEB_SETUP_TOKEN  first-run setup token; delete the secret after setup.
# RTWEB_ASSET_TOKEN  token the SPA handler uses to read large embedded assets from blob storage.

# 4. Node environment (operator, see deploy/rt.rtweb.toml and deploy/Caddyfile)
# RTWEB_OP_TOKEN      operator token injected by binding rtctl-op.
# RTWEB_RELAY_SECRET  shared by binding rtctl-tenant and the Caddy relay (:8082).
# RTWEB_CONSOLE_HOST, ACME_EMAIL  Caddy site settings.
# RTWEB_TENANT_ID     tenant id the rtctl SDK accepts callers from (install substitutes it).

# 5. e2e (e2e/playwright.config.ts, smoke.spec.ts)
# Runtime-hosted console URL (required; no default port).
RTWEB_URL=http://127.0.0.1:8080/s/rtweb
# RTWEB_RUNTIME_PUBLIC_URL (above) is where the smoke checks app URLs; RTWEB_SETUP_TOKEN must
# match the service secret.
RTWEB_SETUP_TOKEN=dev-insecure-setup
