{
  "name": "@21cloud/runtime-web-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "coverage": "vitest run --project unit --coverage",
    "test:int": "vitest run --project integration",
    "deploy": "node scripts/deploy.mjs",
    "ci": "npm run typecheck && npm run lint && npm test",
    "gen-assets": "node scripts/gen-assets.mjs",
    "pretypecheck": "node scripts/gen-assets.mjs",
    "pretest": "node scripts/gen-assets.mjs",
    "precoverage": "node scripts/gen-assets.mjs",
    "rt-install": "node scripts/install.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "hash-wasm": "4.12.0"
  }
}
